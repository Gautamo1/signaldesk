# PostgreSQL connection string (required)
# Local dev: `docker compose up -d db` then use the default below.
DATABASE_URL=postgresql://signaldesk:signaldesk@localhost:5432/signaldesk

# API port (default 4000). On Render, PORT is injected automatically.
PORT=4000

# Optional: add artificial latency (ms) to every /api response — for slow-network QA.
# SIMULATE_LATENCY_MS=800

# Seed the database with a realistic research world when it is empty (default true).
SEED_ON_EMPTY=true
